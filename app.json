{
  "expo": {
    "name": "OwnTrip",
    "owner": "khoale3004",
    "slug": "owntrip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": ["owntrip", "com.khoale3004.owntrip"],
    "extra": {
      "googleWebClientId": "524802175661-62nri3lt2vkio173e1imnt375qt9kjc5.apps.googleusercontent.com",
      "router": {},
      "eas": {
        "projectId": "375ddeaa-4ef3-44e8-89de-e25030f322e3"
      }
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.khoale3004.owntrip",
      "config": {
        "googleMapsApiKey": "AIzaSyDJe6vKECRNVew2g9EHKedjj65EimJ18FI"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDJe6vKECRNVew2g9EHKedjj65EimJ18FI"
        }
      },
      "package": "com.khoale3004.owntrip"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Cho phép OwnTrip sử dụng microphone để nhập lệnh bằng giọng nói.",
          "speechRecognitionPermission": "Cho phép OwnTrip chuyển giọng nói thành văn bản cho trợ lý AI.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxGLImpl": "mapbox"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
